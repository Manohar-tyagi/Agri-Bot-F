/* ============================================================================
   Auth views — scoped to .auth-shell / .auth-view
   ========================================================================= */
.auth-view {
  position: fixed; inset: 0; z-index: 960;
  background: rgba(13,16,20,.45);
  visibility: hidden; pointer-events: none;
  clip-path: var(--c0, circle(0px at 50% 50%));
  transition: clip-path .65s cubic-bezier(.65,0,.35,1);
  overflow-y: auto;
}
.auth-view.is-open {
  visibility: visible; pointer-events: auto;
  clip-path: var(--c1, circle(150vmax at 50% 50%));
}
.auth-view.is-closing { visibility: visible; pointer-events: none; clip-path: var(--c0); }

.auth-shell {
  width: min(100% - 48px, 1120px);
  height: clamp(560px, 78vh, 700px);
  margin: 110px auto 40px;
  background: #e9eae6;
  border-radius: 28px;
  position: relative; overflow: hidden;
}

.auth-left {
  position: absolute; inset: 0; right: 42%;
  display: flex; align-items: center; justify-content: center;
}
.auth-chars { width: min(520px, 100%); max-width: 520px; height: auto; }

.auth-card {
  position: absolute; top: 8px; right: 8px; bottom: 8px;
  width: 42%; min-width: 400px;
  background: #fff; border-radius: 22px;
  padding: 40px 48px;
  display: flex; flex-direction: column; align-items: center;
  overflow-y: auto;
}

.auth-logo { margin-bottom: 8px; }
.auth-logo-mark {
  display: inline-block; width: 44px; height: 44px; border-radius: 50%;
  background: #14a35c;
}
.auth-title { font-size: 34px; font-weight: 800; font-family: 'Archivo Black', 'Arial Black', sans-serif; color: #111418; margin: 6px 0 4px; text-align: center; }
.auth-sub { font-size: 15px; color: #4a535c; margin: 0 0 24px; text-align: center; }

.auth-form { width: 100%; display: flex; flex-direction: column; gap: 18px; }
.auth-field { position: relative; padding-top: 18px; }
.auth-field input {
  width: 100%; height: 56px; border: 0; border-bottom: 1.5px solid #bfc4c7;
  background: transparent; font-size: 16px; color: #111418;
  padding: 0 40px 0 0; outline: none;
}
.auth-field label {
  position: absolute; left: 0; top: 30px; font-size: 16px; color: #5a6570;
  transition: all .2s ease; pointer-events: none;
}
.auth-field input:focus ~ label,
.auth-field input:not(:placeholder-shown) ~ label {
  top: 0; font-size: 12px; color: #111418;
}
.auth-field input:focus { border-bottom-color: #111418; border-bottom-width: 2px; }
.auth-field.is-invalid input { border-bottom-color: #e5484d; }
.auth-err { font-size: 13.5px; color: #c93a3f; margin: 4px 0 0; min-height: 18px; }
.auth-hint { font-size: 13px; color: #5a6570; margin: 4px 0 0; }

.auth-field--pw .auth-eye {
  position: absolute; right: 0; top: 30px; background: none; border: 0; cursor: pointer; padding: 6px; color: #5a6570;
}
.auth-field--pw .auth-eye svg { width: 20px; height: 20px; }

.auth-strength { display: flex; gap: 6px; margin-top: 6px; }
.auth-strength span { flex: 1; height: 4px; background: #e3e5e0; border-radius: 2px; }
.auth-strength span.ok { background: #14a35c; }

.auth-row { display: flex; align-items: center; justify-content: space-between; font-size: 14px; }
.auth-check { display: flex; align-items: center; gap: 8px; color: #111418; }
.auth-link { font-size: 13.5px; color: #5a6570; text-decoration: none; }
.auth-link:hover { text-decoration: underline; }

.auth-btn {
  width: 100%; height: 52px; border-radius: 999px; border: 0; cursor: pointer;
  font-size: 16px; font-weight: 600; transition: transform .2s ease, box-shadow .2s ease;
}
.auth-btn--primary { background: #111418; color: #fff; }
.auth-btn--primary:hover { transform: translateY(-1px); box-shadow: 0 0 0 3px rgba(61,220,132,.35); }
.auth-btn--primary:disabled { opacity: .6; cursor: not-allowed; }
.auth-btn--secondary { background: #f1f2ee; color: #111418; border: 1px solid #e3e5e0; height: 44px; font-size: 14px; }
.auth-btn--secondary svg { width: 16px; height: 16px; vertical-align: middle; margin-right: 6px; }

.auth-banner {
  background: #fef2f2; color: #991b1b; padding: 10px 14px; border-radius: 10px;
  font-size: 14px; text-align: center;
}
.auth-banner button { background: none; border: 0; color: #991b1b; text-decoration: underline; cursor: pointer; }

.auth-bottom { font-size: 14px; color: #5a6570; text-align: center; margin-top: 8px; }
.auth-bottom a { color: #14a35c; font-weight: 600; }

.auth-note { font-size: 13.5px; color: #5a6570; background: #f1f2ee; padding: 10px 12px; border-radius: 8px; }

.auth-steps { display: flex; gap: 8px; width: 100%; margin-bottom: 6px; }
.auth-stepbar { flex: 1; height: 4px; background: #e3e5e0; border-radius: 2px; }
.auth-stepbar.active { background: #14a35c; }
.auth-steplabel { font-size: 12px; color: #5a6570; margin-bottom: 12px; align-self: flex-start; }
.auth-chip { background: #e7f5ec; color: #0b7a43; padding: 6px 12px; border-radius: 999px; font-size: 13px; font-weight: 600; margin-bottom: 12px; align-self: flex-start; }
.auth-success { display: flex; flex-direction: column; align-items: center; gap: 12px; }
.auth-check { width: 64px; height: 64px; }

/* mobile */
@media (max-width: 900px) {
  .auth-shell { height: auto; margin-top: 80px; }
  .auth-left { position: relative; height: 200px; right: 0; }
  .auth-chars { max-width: 260px; }
  .auth-card { position: relative; top: 0; right: 0; bottom: 0; width: 100%; min-width: 0; }
}

.auth-chars .char-body { transition: transform .25s ease; }
.auth-chars .face { transition: transform .25s ease; }
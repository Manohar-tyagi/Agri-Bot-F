/* login-crew.js: the four animated characters for the Agri-Pal login page.
   Draws its own SVG (no image files). Faces follow the pointer, react to the form,
   blink, hop, giggle, look sad on errors and cheer on success.
   Usage:  const crew = LoginCrew.create(document.getElementById('stage'));
           crew.setState('password');   // 'idle' | 'email' | 'password' | 'passwordShown' | 'submitting' | 'error' | 'success' | 'cheer'
           crew.setState('email', inputElement);   // they look at that element while it is focused
*/
(function (global) {
  'use strict';
  var INK = '#15191c';
  var CFG = {
    tall:  { fill: '#1fb56a', pivot: [150, 270], face: [150, 28],  type: 'white', ex: 17, er: 7.5, pr: 3.4, my: 13, mw: 16, shift: 9 },
    round: { fill: '#f58a35', pivot: [108, 270], face: [108, 232], type: 'dot',   ex: 20, er: 3.6, pr: 3.6, my: 13, mw: 18, shift: 12 },
    short: { fill: '#e8433f', pivot: [212, 270], face: [212, 102], type: 'white', ex: 10, er: 7,   pr: 3.2, my: 15, mw: 12, shift: 8 },
    pill:  { fill: '#f2d04a', pivot: [275, 270], face: [275, 162], type: 'dot',   ex: 10, er: 3.2, pr: 3.2, my: 14, mw: 26, shift: 10 }
  };
  var DRAW = ['tall', 'round', 'short', 'pill'];            // back to front
  var ENTER = { round: 0, tall: 0.09, short: 0.18, pill: 0.27 };   // seconds, stagger of the entrance
  var BODY = {
    tall:  '<rect x="88" y="6" width="124" height="264" rx="18"/>',
    round: '<path d="M5 270 A103 103 0 0 1 211 270 Z"/>',
    short: '<rect x="175" y="85" width="75" height="185" rx="8"/>',
    pill:  '<path d="M232 270 V178 A43 43 0 0 1 318 178 V270 Z"/>'
  };

  function eyeMarkup(key, side) {
    var c = CFG[key], cx = side * c.ex, r = c.type === 'white' ? c.er : 5;
    var inner = c.type === 'white'
      ? '<circle class="white" cx="' + cx + '" cy="0" r="' + c.er + '" fill="#fff"/><circle class="pupil" cx="' + cx + '" cy="0" r="' + c.pr + '" fill="' + INK + '"/>'
      : '<circle class="pupil" cx="' + cx + '" cy="0" r="' + c.pr + '" fill="' + INK + '"/>';
    var lid = '<path class="lid" d="M' + (cx - r + 1) + ' 1 Q' + cx + ' ' + (-r + 1) + ' ' + (cx + r - 1) + ' 1" fill="none" stroke="' + INK + '" stroke-width="2.6" stroke-linecap="round" opacity="0"/>';
    return '<g class="crew-eye" data-cx="' + cx + '"><g class="eyeG">' + inner + '</g>' + lid + '</g>';
  }
  function markup() {
    var g = '';
    DRAW.forEach(function (k) {
      var c = CFG[k];
      g += '<g class="char" data-ch="' + k + '" fill="' + c.fill + '">' + BODY[k] +
        '<g class="face">' + eyeMarkup(k, -1) + eyeMarkup(k, 1) +
        '<path class="mouth" fill="none" stroke="' + INK + '" stroke-width="3" stroke-linecap="round" d=""/></g></g>';
    });
    return '<svg class="crew" viewBox="0 0 330 280" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" style="overflow:visible;display:block;width:100%;height:auto">' +
      '<defs><clipPath id="crewGround"><rect x="-80" y="-120" width="490" height="392"/></clipPath></defs>' +
      '<g clip-path="url(#crewGround)">' + g + '</g></svg>';
  }
  function easeOutBack(x) { var c1 = 1.2, c3 = c1 + 1; return 1 + c3 * Math.pow(x - 1, 3) + c1 * Math.pow(x - 1, 2); }
  function clamp(v, a, b) { return Math.min(b, Math.max(a, v)); }

  function create(container, opts) {
    opts = opts || {};
    container.innerHTML = markup();
    var svg = container.querySelector('svg');
    var reduced = opts.reducedMotion != null ? opts.reducedMotion : !!(global.matchMedia && global.matchMedia('(prefers-reduced-motion: reduce)').matches);
    var seed = opts.seed || 20261115;
    function rnd() { seed = (seed * 16807) % 2147483647; return seed / 2147483647; }

    var chars = {};
    DRAW.forEach(function (k) {
      var g = svg.querySelector('[data-ch="' + k + '"]'), eyes = g.querySelectorAll('.crew-eye');
      chars[k] = {
        key: k, cfg: CFG[k], g: g, face: g.querySelector('.face'), mouth: g.querySelector('.mouth'),
        eyes: [0, 1].map(function (i) { var e = eyes[i]; return { g: e.querySelector('.eyeG'), pupil: e.querySelector('.pupil'), lid: e.querySelector('.lid'), cx: +e.getAttribute('data-cx') }; }),
        offX: 0, offY: 0, pupX: 0, pupY: 0, lean: 0, mouthC: 0.6, open: 1, pupil: 1, sx: 1, sy: 1, rot: 0, wide: 1,
        jy: 0, jv: 0, jigA: 0, jigT: 0, blinkT: -1, nextBlink: 1.2 + rnd() * 2.5, phase: rnd() * 6.28, hovered: false
      };
    });

    var t = 0, state = 'idle', stateEl = null, stateTimer = 0, pointerSvg = null, hopIn = 6 + rnd() * 3;
    var entranceDone = reduced, destroyed = false, running = false, visible = true, raf = 0, lastNow = 0;

    function clientToSvg(x, y) {
      if (opts.clientToSvg) return opts.clientToSvg(x, y);
      var m = svg.getScreenCTM && svg.getScreenCTM();
      if (!m) return null;
      var p = new DOMPoint(x, y).matrixTransform(m.inverse());
      return { x: p.x, y: p.y };
    }
    function elementPoint(el) {
      var r = el.getBoundingClientRect();
      if (!r.width && !r.height) return null;
      return clientToSvg(r.left + r.width / 2, r.top + r.height / 2);
    }

    // What each character wants to look like in each state.
    function targets(s, key, hovered) {
      var o = { mouthC: 0.6, open: 1, pupil: 1, look: 'pointer', rot: 0, sx: 1, sy: 1, wide: 1 };
      switch (s) {
        case 'email':
          o.mouthC = 0.85; o.look = 'element'; break;
        case 'password':                      // polite: look away, some close their eyes
          o.look = 'away'; o.mouthC = 0.05;
          if (key === 'tall' || key === 'round') o.open = 0;
          break;
        case 'passwordShown':
          if (key === 'tall' || key === 'round') { o.open = 0; o.mouthC = 0.2; }
          else if (key === 'short') { o.look = 'away'; o.mouthC = 0.05; }
          else { o.look = 'element'; o.mouthC = 0.4; }      // the yellow one peeks
          break;
        case 'submitting':
          o.pupil = 0.55; o.mouthC = 0; o.wide = 1.12; break;
        case 'error':
          o.mouthC = -0.85; o.look = 'down';
          if (key === 'tall')  { o.rot = -4; o.sy = 0.96; o.sx = 1.03; }
          if (key === 'round') { o.sy = 0.94; o.sx = 1.02; }
          if (key === 'short') { o.rot = 3; }
          if (key === 'pill')  { o.rot = -2; }
          break;
        case 'success': case 'cheer':
          o.mouthC = 1.25; o.open = (key === 'round' || key === 'short') ? 0 : 1; break;
      }
      if (hovered) o.mouthC = Math.max(o.mouthC, 1.0);
      return o;
    }

    function hop(key, power) {
      var c = chars[key || DRAW[Math.floor(rnd() * DRAW.length)]];
      if (!c || reduced) return;
      c.jv += power || 190; c.jigA = Math.max(c.jigA, 2.5); c.jigT = 0;
    }
    function setState(s, el) {
      state = s; stateEl = el || (s === 'email' || s === 'passwordShown' ? stateEl : null);
      clearTimeout(stateTimer);
      if (s === 'error') stateTimer = setTimeout(function () { if (state === 'error') setState('idle'); }, 2800);
      if (s === 'success' || s === 'cheer') ['round', 'tall', 'short', 'pill'].forEach(function (k, i) { setTimeout(function () { hop(k, 230); }, i * 90); });
    }

    function tick(dt) {
      dt = Math.min(Math.max(dt, 0.0001), 0.05); t += dt;
      var elPt = stateEl ? elementPoint(stateEl) : null;
      if (!entranceDone && t > 0.27 + 0.85 + 0.05) entranceDone = true;

      DRAW.forEach(function (k) {
        var c = chars[k], f = c.cfg, tg = targets(state, k, c.hovered);
        var a = 1 - Math.exp(-(reduced ? 40 : 10) * dt);
        var fc = { x: f.face[0], y: f.face[1] }, P;
        if (reduced) P = fc;
        else if (tg.look === 'away') P = { x: fc.x - 400, y: fc.y - 220 };
        else if (tg.look === 'down') P = { x: fc.x, y: fc.y + 140 };
        else if (tg.look === 'element' && elPt) P = elPt;
        else P = pointerSvg || { x: 165, y: 150 };
        var dx = P.x - fc.x, dy = P.y - fc.y, d = Math.hypot(dx, dy) || 1, ux = dx / d, uy = dy / d;
        var s = Math.min(1, d / 160), ps = Math.min(1, d / 70), pr = f.type === 'white' ? 2.6 : 1.8;
        c.offX += (ux * f.shift * s - c.offX) * a;       c.offY += (uy * f.shift * 0.7 * s - c.offY) * a;
        c.pupX += (ux * pr * ps - c.pupX) * a;           c.pupY += (uy * pr * ps - c.pupY) * a;
        c.lean += (((tg.look === 'pointer' && !reduced) ? clamp(dx / 260, -1, 1) * 2.2 : 0) - c.lean) * a;
        c.mouthC += (tg.mouthC - c.mouthC) * a; c.open += (tg.open - c.open) * a; c.pupil += (tg.pupil - c.pupil) * a;
        c.sx += (tg.sx - c.sx) * a; c.sy += (tg.sy - c.sy) * a; c.rot += (tg.rot - c.rot) * a; c.wide += (tg.wide - c.wide) * a;

        // blink
        c.nextBlink -= dt;
        if (c.blinkT < 0 && c.nextBlink <= 0) c.blinkT = 0;
        var blink = 0;
        if (c.blinkT >= 0) { c.blinkT += dt; blink = Math.sin(Math.PI * Math.min(1, c.blinkT / 0.16)); if (c.blinkT >= 0.16) { c.blinkT = -1; c.nextBlink = 2.5 + rnd() * 2.5; } }

        // hop spring and giggle
        if (!reduced) {
          c.jv += (-140 * c.jy - 9 * c.jv) * dt; c.jy = clamp(c.jy + c.jv * dt, -40, 40);
          if (c.jigA > 0.01) { c.jigT += dt; if (c.jigT > 1) c.jigA = 0; }
        }
        var jig = c.jigA > 0.01 ? c.jigA * Math.exp(-6 * c.jigT) * Math.sin(32 * c.jigT) : 0;

        // entrance from below the ground line
        var enterY = 0;
        if (!entranceDone) { var te = (t - ENTER[k]) / 0.85; enterY = te < 0 ? 300 : te < 1 ? (1 - easeOutBack(te)) * 300 : 0; }
        var tremble = (state === 'submitting' && !reduced) ? Math.sin(t * 70 + c.phase) * 0.7 : 0;
        var breathe = reduced ? 0 : 0.006 * Math.sin(t * 1.6 + c.phase);

        // eyes
        var scY = Math.max(0.05, c.open * c.wide * (1 - 0.94 * blink));
        var eyeOp = clamp(c.open * 2.2, 0, 1), lidOp = clamp(1 - c.open * 2.2, 0, 1);
        c.eyes.forEach(function (e) {
          e.g.setAttribute('transform', 'translate(' + e.cx + ' 0) scale(1 ' + scY.toFixed(3) + ') translate(' + (-e.cx) + ' 0)');
          e.g.setAttribute('opacity', eyeOp.toFixed(2)); e.lid.setAttribute('opacity', lidOp.toFixed(2));
          e.pupil.setAttribute('transform', 'translate(' + c.pupX.toFixed(2) + ' ' + c.pupY.toFixed(2) + ')');
          e.pupil.setAttribute('r', (f.pr * c.pupil).toFixed(2));
        });
        // mouth: a curve whose bend goes from frown (-1) through flat (0) to a big smile (1+)
        var mc = c.mouthC, h = f.mw / 2 * (1 + 0.18 * Math.max(0, mc - 0.6)), y0 = f.my + (mc < 0 ? -mc * 3 : 0);
        c.mouth.setAttribute('d', 'M' + (-h).toFixed(2) + ' ' + y0.toFixed(2) + ' Q0 ' + (y0 + mc * h * 0.9).toFixed(2) + ' ' + h.toFixed(2) + ' ' + y0.toFixed(2));
        // face and body
        c.face.setAttribute('transform', 'translate(' + (f.face[0] + c.offX).toFixed(2) + ' ' + (f.face[1] + c.offY).toFixed(2) + ')');
        var px = f.pivot[0], py = f.pivot[1], dyT = -c.jy + enterY + tremble, rot = c.rot + c.lean + jig;          // applied as a skew so the flat bottoms stay on the ground
        c.g.setAttribute('transform', 'translate(' + px + ' ' + (py + dyT).toFixed(2) + ') skewX(' + (-rot).toFixed(2) + ') scale(' + c.sx.toFixed(3) + ' ' + (c.sy * (1 + breathe)).toFixed(3) + ') translate(' + (-px) + ' ' + (-py) + ')');
      });

      hopIn -= dt;
      if (hopIn <= 0) { hopIn = 7 + rnd() * 4; if (state === 'idle') hop(); }
    }

    // pointer, hover and click
    function onMove(e) { var p = clientToSvg(e.clientX, e.clientY); if (p) pointerSvg = p; }
    global.addEventListener('pointermove', onMove, { passive: true });
    DRAW.forEach(function (k) {
      var c = chars[k];
      c.g.addEventListener('mouseenter', function () { c.hovered = true; if (!reduced) { c.jigA = 3; c.jigT = 0; } });
      c.g.addEventListener('mouseleave', function () { c.hovered = false; });
      c.g.addEventListener('pointerdown', function () { hop(k, 220); c.jigA = 5; c.jigT = 0; });
    });

    function loop(now) {
      if (destroyed) return;
      raf = requestAnimationFrame(loop);
      var dt = lastNow ? (now - lastNow) / 1000 : 0.016; lastNow = now;
      if (document.hidden || !visible) return;
      tick(dt);
    }
    var io = null;
    if (global.IntersectionObserver) { io = new IntersectionObserver(function (es) { visible = es[0].isIntersecting; }); io.observe(container); }
    function start() { if (!running && !destroyed) { running = true; raf = requestAnimationFrame(loop); } }
    // safety net: if animation frames never run, still show the finished characters
    var safety = setTimeout(function () { if (!lastNow) { entranceDone = true; tick(0.016); } }, 2500);

    tick(0.016);      // draw a first frame right away
    if (opts.autostart !== false) start();

    return {
      setState: setState,
      getState: function () { return state; },
      lookAtElement: function (el) { stateEl = el; },
      hop: hop,
      tick: tick,
      start: start,
      setPointerSvg: function (x, y) { pointerSvg = x == null ? null : { x: x, y: y }; },
      svg: svg,
      destroy: function () { destroyed = true; cancelAnimationFrame(raf); clearTimeout(stateTimer); clearTimeout(safety); global.removeEventListener('pointermove', onMove); if (io) io.disconnect(); container.innerHTML = ''; }
    };
  }
  global.LoginCrew = { create: create };
})(typeof window !== 'undefined' ? window : this);